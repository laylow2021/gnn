   "source": [
    "# AML Graph Autoencoder - OOT Testing, Visualization & Excel Export\n",
    "This notebook demonstrates Training, Persistence, OOT Testing, and advanced interpretation with ranked anomaly exports."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, sys\n",
    "sys.path.append(os.path.abspath(\"../\"))\n",
    "import yaml, torch, pandas as pd, numpy as np\n",
    "import torch.nn.functional as F\n",
    "import matplotlib.pyplot as plt\n",
    \"from src.utils.reproducibility import set_seed, save_checkpoint, load_checkpoint, get_device\\n\",
    "from src.data.generator import generate_transactions\n",
    "from src.graph.builder import GraphBuilder\n",
    "from src.models.gnn import AMLGraphAutoencoder, compute_combined_loss\n",
    "from src.explain.interpreter import AnomalyInterpreter\n",
    "\n",
    "# 0. Setup\n",
    \"with open('../config/config.yaml', 'r') as f:\\n\",
    \"    config = yaml.safe_load(f)\\n\",
    \"set_seed(42)\\n\",
    \"device = get_device(config)\\n\",
    \"print(f\\\"Using device: {device}\\\")\\n\",

    "\n",
    "os.makedirs('../artifacts', exist_ok=True)\n",
    "os.makedirs('../output', exist_ok=True)\n",
    "\n",
    "# 1. Generate Data with Temporal Split\n",
    "NUM_CUSTOMERS = config['data']['num_customers']\n",
    "full_tx_df = generate_transactions(num_customers=NUM_CUSTOMERS, num_days=40, anomaly_ratio=0.05)\n",
    "\n",
    "# Filter to ensure we don't have IDs exceeding our fixed node count if generator slightly fluctuates\n",
    "c_id_col = config['data']['column_mapping']['customer_id']\n",
    "full_tx_df = full_tx_df[full_tx_df[c_id_col] < NUM_CUSTOMERS]\n",
    "\n",
    "train_df = full_tx_df[full_tx_df['date'] < '2026-02-01'].copy()\n",
    "oot_df = full_tx_df[full_tx_df['date'] >= '2026-02-01'].copy()\n",
    "print(f\"Train Ledger: {len(train_df)} tx | OOT Ledger: {len(oot_df)} tx\")\n",
    "\n",
    \"# 2. Build Training Graph & Train Model\\n\",
    \"train_builder = GraphBuilder(config)\\n\",
    \"train_data = train_builder.build_graph(train_df, fit_scaler=True)\\n\",
    \"train_data = train_data.to(device)\\n\",
    \"\\n\",
    \"model = AMLGraphAutoencoder(train_data.num_node_features, train_data.num_edge_features, config).to(device)\\n\",

    "optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n",
    "\n",
    "history = {'Total Loss': [], 'Node MSE': [], 'Edge MSE': []}\n",
    "\n",
    "print(\"Training on Month 1...\")\n",
    "model.train()\n",
    "for epoch in range(101):\n",
    "    optimizer.zero_grad()\n",
    "    z, x_recon, edge_recon = model(train_data.x, train_data.edge_index, train_data.edge_attr)\n",
    "    loss, node_mse_val, edge_mse_val = compute_combined_loss(train_data.x, x_recon, train_data.edge_attr, edge_recon, config)\n",
    "    loss.backward()\n",
    "    optimizer.step()\n",
    "    \n",
    "    history['Total Loss'].append(loss.item())\n",
    "    history['Node MSE'].append(node_mse_val.item())\n",
    "    history['Edge MSE'].append(edge_mse_val.item())\n",
    "    if epoch % 50 == 0: print(f\"Epoch {epoch:3d} | Loss: {loss.item():.4f}\")\n",
    "\n",
    "# 3. Save Pipeline Checkpoint\n",
    "save_checkpoint(model, train_builder.scaler, config, '../artifacts/model_v1')\n",
    "\n",
    \"# 4. OOT Inference\\n\",
    \"print(\\\"\\\\n--- Starting OOT Testing (Month 2) ---\\\")\\n\",
    \"loaded_model, loaded_scaler, loaded_config = load_checkpoint(\\n\",
    \"    AMLGraphAutoencoder, '../artifacts/model_v1', train_data.num_node_features, train_data.num_edge_features, device=device\\n\",
    \")\\n\",
    \"\\n\",
    \"oot_builder = GraphBuilder(loaded_config, scaler=loaded_scaler)\\n\",
    \"oot_data = oot_builder.build_graph(oot_df, fit_scaler=False)\\n\",
    \"oot_data = oot_data.to(device)\\n\",

    "\n",
    "loaded_model.eval()\n",
    "with torch.no_grad():\n",
    "    _, x_recon_oot, edge_recon_oot = loaded_model(oot_data.x, oot_data.edge_index, oot_data.edge_attr)\n",
    "    # Note: We use reduction='none' and mean over features to get per-node/per-edge error\n",
    "    node_errors = torch.mean((oot_data.x - x_recon_oot)**2, dim=1)\n",
    "    edge_errors = torch.mean((oot_data.edge_attr - edge_recon_oot)**2, dim=1)\n",
    "\n",
    "# 5. Interpretation & Visualizations\n",
    "interpreter = AnomalyInterpreter(loaded_model, loaded_config)\n",
    "\n",
    "# A. Loss Curves\n",
    "interpreter.plot_loss_curves(history)\n",
    "\n",
    "# B. Local Neighborhood with Multi-Hops & Color Coding\n",
    "top_hub = int(torch.argmax(node_errors))\n",
    "print(f\"\\nAnalyzing Top Anomalous Node: {top_hub} (Score: {node_errors[top_hub]:.4f})\")\n",
    "interpreter.local_perspective(top_hub, oot_data, node_errors, edge_errors, num_hops=2)\n",
    "\n",
    "# C. Ranked Anomaly Export to Excel\n",
    "print(\"\\nExporting anomalies to output/anomalies.xlsx...\")\n",
    "interpreter.save_anomalies_to_excel(oot_data, node_errors, edge_errors, oot_df, '../output/anomalies.xlsx')\n",
    "\n",
    "# Global Explanations\n",
    "print(\"\\nGlobal Node Feature Importance (Error Contribution):\")\n",
    "interpreter.explain_node_anomalies(oot_data.x, x_recon_oot)\n",
    "print(\"\\nGlobal Edge Feature Importance (Error Contribution):\")\n",
    "interpreter.explain_edge_anomalies(oot_data.edge_attr, edge_recon_oot)"
   ]
  }
 ],
